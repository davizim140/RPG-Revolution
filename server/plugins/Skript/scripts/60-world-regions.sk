options:
    prefix: &8[&6RPG Revolution&8] &r

# Configure one RPG region per Minecraft world.
# Admin: /rpgregiao definir <nome> <nivel-minimo>
# Player: /rpgregiao

command /rpgregiao [<text>] [<integer>]:
    permission: rpg.admin
    permission message: &cVocê não tem permissão para configurar regiões.
    trigger:
        if arg-1 is "definir":
            if arg-2 is not set:
                send "{@prefix}&cUse /rpgregiao definir <nome> <nivel-minimo>." to sender
                stop
            if arg-2 < 1:
                send "{@prefix}&cO nível mínimo precisa ser pelo menos 1." to sender
                stop
            set {rpg::world::%world of player%::name} to arg-2
            set {rpg::world::%world of player%::min-level} to arg-2
            send "{@prefix}&aRegião deste mundo configurada." to player
            stop
        send "{@prefix}&eUso administrativo: /rpgregiao definir <nome> <nivel-minimo>" to sender

command /regiao:
    aliases: /regiões, /regioes
    trigger:
        set {_world} to "%world of player%"
        if {rpg::world::%{_world}%::name} is set:
            send "&6&lREGIÃO ATUAL" to player
            send "&eRegião: &f%{rpg::world::%{_world}%::name}%" to player
            send "&eNível recomendado: &f%{rpg::world::%{_world}%::min-level}%" to player
        else:
            send "&6&lREGIÃO ATUAL" to player
            send "&eMundo: &f%{_world}%" to player
            send "&7Esta região ainda não foi configurada pela administração." to player

command /rpgmundos:
    trigger:
        send "&6&lGUIA DE EXPLORAÇÃO" to player
        send "&7Cada mundo pode receber nome e nível recomendado com /rpgregiao definir."
        send "&7Converse com a administração antes de entrar em áreas de nível alto." to player
