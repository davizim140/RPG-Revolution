options:
    prefix: &8[&6RPG Revolution&8] &r

# Expedição solo com duas ondas e chefe. Cada criatura é vinculada ao dono por UUID.
command /expedicao [<text>]:
    aliases: /masmorraexpedicao
    trigger:
        set {_id} to "%uuid of player%"
        if arg-1 is "cancelar":
            if {rpg::expedition::%{_id}%::active} is not true:
                send "{@prefix}&cVocê não tem uma expedição ativa." to player
                stop
            loop all entities:
                if {rpg::expedition::mob-owner::%uuid of loop-entity%} is {_id}:
                    delete {rpg::expedition::mob-owner::%uuid of loop-entity%}
                    kill loop-entity
            delete {rpg::expedition::%{_id}%::*}
            send "{@prefix}&eExpedição cancelada. Nenhuma recompensa foi concedida." to player
            stop
        if arg-1 is set:
            send "{@prefix}&e/expedicao &7- Inicia uma expedição (nível 10+)." to player
            send "{@prefix}&e/expedicao cancelar &7- Cancela e remove os inimigos." to player
            stop
        if {rpg::%{_id}%::level} < 10:
            send "{@prefix}&cVocê precisa do nível 10 para entrar." to player
            stop
        if {rpg::expedition::%{_id}%::active} is true:
            send "{@prefix}&cVocê já está em uma expedição." to player
            stop
        set {rpg::expedition::%{_id}%::active} to true
        set {rpg::expedition::%{_id}%::wave} to 1
        set {rpg::expedition::%{_id}%::remaining} to 3
        loop 3 times:
            spawn zombie at location of player
            set {_mob} to last spawned entity
            set name of {_mob} to "&cGuardião da Expedição"
            set max health of {_mob} to 25
            set health of {_mob} to 25
            set {rpg::expedition::mob-owner::%uuid of {_mob}%} to {_id}
        send "{@prefix}&6&lEXPEDIÇÃO INICIADA! &7Onda 1/3: derrote os três guardiões." to player

on death of living entity:
    set {_owner} to {rpg::expedition::mob-owner::%uuid of victim%}
    if {_owner} is set:
        delete {rpg::expedition::mob-owner::%uuid of victim%}
        if {rpg::expedition::%{_owner}%::active} is true:
            remove 1 from {rpg::expedition::%{_owner}%::remaining}
            if {rpg::expedition::%{_owner}%::remaining} <= 0:
                set {_wave} to {rpg::expedition::%{_owner}%::wave}
                loop all players:
                    if "%uuid of loop-player%" is {_owner}:
                        if {_wave} is 1:
                            set {rpg::expedition::%{_owner}%::wave} to 2
                            set {rpg::expedition::%{_owner}%::remaining} to 4
                            loop 4 times:
                                spawn skeleton at location of loop-player
                                set {_mob} to last spawned entity
                                set name of {_mob} to "&5Arqueiro da Expedição"
                                set max health of {_mob} to 30
                                set health of {_mob} to 30
                                set {rpg::expedition::mob-owner::%uuid of {_mob}%} to {_owner}
                            send "{@prefix}&5Onda 2/3! &7Quatro arqueiros bloquearam seu caminho." to loop-player
                        else if {_wave} is 2:
                            set {rpg::expedition::%{_owner}%::wave} to 3
                            set {rpg::expedition::%{_owner}%::remaining} to 1
                            spawn ravager at location of loop-player
                            set {_boss} to last spawned entity
                            set name of {_boss} to "&4&lDEVORADOR DAS RUÍNAS"
                            set max health of {_boss} to 180
                            set health of {_boss} to 180
                            apply resistance 1 to {_boss} for 999999 seconds
                            set {rpg::expedition::mob-owner::%uuid of {_boss}%} to {_owner}
                            send "{@prefix}&4&lCHEFE FINAL! &cO Devorador das Ruínas apareceu!" to loop-player
                        else:
                            delete {rpg::expedition::%{_owner}%::*}
                            add 600 to {rpg::%{_owner}%::coins}
                            loop all players:
                                if "%uuid of loop-player%" is {_owner}:
                                    rpg_add_xp(loop-player, 400)
                                    give loop-player 3 diamonds
                                    send "{@prefix}&6&lEXPEDIÇÃO CONCLUÍDA! &a600 moedas, 400 XP e 3 diamantes." to loop-player

on quit:
    set {_id} to "%uuid of player%"
    if {rpg::expedition::%{_id}%::active} is true:
        loop all entities:
            if {rpg::expedition::mob-owner::%uuid of loop-entity%} is {_id}:
                delete {rpg::expedition::mob-owner::%uuid of loop-entity%}
                kill loop-entity
        delete {rpg::expedition::%{_id}%::*}
