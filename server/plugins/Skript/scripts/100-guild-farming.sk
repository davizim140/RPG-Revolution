options:
    prefix: &8[&6RPG Revolution&8] &r
    territory-radius: 16

# Estatisticas de colheita: contam apenas culturas maduras em territorios
# pertencentes a guilda do jogador. Nao altera drops nem concede XP/moedas.
on break:
    if event-block is wheat or carrots or potatoes or beetroot or nether wart:
        if age of event-block is maximum age of event-block:
            set {_uuid} to "%uuid of player%"
            set {_guild} to {rpg::%{_uuid}%::guild}
            if {_guild} is not set:
                stop
            loop {rpg::territories::*}:
                set {_territory} to loop-value
                if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
                    set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
                    set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
                    if abs({_dx}) <= {@territory-radius}:
                        if abs({_dz}) <= {@territory-radius}:
                            if {rpg::territory::%{_territory}%::guild} is {_guild}:
                                add 1 to {rpg::%{_uuid}%::farm::harvests}
                                add 1 to {rpg::guild::%{_guild}%::farm::harvests}
                                if {rpg::%{_uuid}%::farm::level} is not set:
                                    set {rpg::%{_uuid}%::farm::level} to 1
                                if {rpg::%{_uuid}%::farm::xp} is not set:
                                    set {rpg::%{_uuid}%::farm::xp} to 0
                                add 5 to {rpg::%{_uuid}%::farm::xp}
                                while {rpg::%{_uuid}%::farm::xp} >= ({rpg::%{_uuid}%::farm::level} * 100):
                                    set {_needed} to {rpg::%{_uuid}%::farm::level} * 100
                                    remove {_needed} from {rpg::%{_uuid}%::farm::xp}
                                    add 1 to {rpg::%{_uuid}%::farm::level}
                                    add 50 to {rpg::%{_uuid}%::coins}
                                    if {rpg::%{_uuid}%::farm::level} >= 15:
                                        set {rpg::%{_uuid}%::farm::title} to "Mestre da Colheita"
                                    else if {rpg::%{_uuid}%::farm::level} >= 10:
                                        set {rpg::%{_uuid}%::farm::title} to "Cultivador Veterano"
                                    else if {rpg::%{_uuid}%::farm::level} >= 5:
                                        set {rpg::%{_uuid}%::farm::title} to "Agricultor Experiente"
                                    else:
                                        set {rpg::%{_uuid}%::farm::title} to "Aprendiz Rural"
                                    send "{@prefix}&aAgricultura subiu para o nível &e%{rpg::%{_uuid}%::farm::level}%&a! Recompensa: &e50 moedas&a." to player
                                    if {rpg::%{_uuid}%::farm::level} mod 5 is 0:
                                        add 100 to {rpg::%{_uuid}%::coins}
                                        send "{@prefix}&6Novo título: &e%{rpg::%{_uuid}%::farm::title}%&6! Bônus: &e+100 moedas." to player
                            stop

command /guildcolheita:
    trigger:
        set {_uuid} to "%uuid of player%"
        set {_guild} to {rpg::%{_uuid}%::guild}
        if {_guild} is not set:
            send "{@prefix}&cVocê precisa pertencer a uma guilda." to player
            stop
        set {_personal} to {rpg::%{_uuid}%::farm::harvests}
        set {_farmLevel} to {rpg::%{_uuid}%::farm::level}
        set {_farmXp} to {rpg::%{_uuid}%::farm::xp}
        set {_farmTitle} to {rpg::%{_uuid}%::farm::title}
        if {_farmTitle} is not set:
            if {_farmLevel} >= 15:
                set {_farmTitle} to "Mestre da Colheita"
            else if {_farmLevel} >= 10:
                set {_farmTitle} to "Cultivador Veterano"
            else if {_farmLevel} >= 5:
                set {_farmTitle} to "Agricultor Experiente"
            else:
                set {_farmTitle} to "Aprendiz Rural"
        if {_farmLevel} is not set:
            set {_farmLevel} to 1
        if {_farmXp} is not set:
            set {_farmXp} to 0
        set {_farmNeeded} to {_farmLevel} * 100
        set {_guildTotal} to {rpg::guild::%{_guild}%::farm::harvests}
        if {_personal} is not set:
            set {_personal} to 0
        if {_guildTotal} is not set:
            set {_guildTotal} to 0
        send "&6&lESTATÍSTICAS DA FAZENDA" to player
        send "&eSua colheita: &f%{_personal}% culturas maduras." to player
        send "&eNível de agricultura: &f%{_farmLevel}% &8| &eXP: &f%{_farmXp}%&7/&f%{_farmNeeded}%" to player
        send "&eTítulo agrícola: &6%{_farmTitle}%" to player
        send "&7Cada colheita madura concede 5 XP. Cada nível concede 50 moedas; níveis múltiplos de 5 dão +100 moedas bônus." to player
        send "&eColheita total da guilda &6%{_guild}%&e: &f%{_guildTotal}%." to player
