options:
    prefix: &8[&6RPG Revolution&8] &r

command /guilda:
    aliases: /g
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is not set:
            send "&6&lSISTEMA DE GUILDAS" to player
            send "&e/guildacriar <nome>" to player
            send "&e/guildaconvidar <jogador>" to player
            send "&e/guildaaceitar" to player
            send "&e/guildainfo" to player
            send "&e/guildasair" to player
            send "&e/guildatransferir <jogador>" to player
            send "&e/guildaexpulsar <jogador>" to player
            send "&e/guildchat <mensagem>" to player
            send "&e/guildabanco <depositar|sacar> <valor>" to player
            send "&e/guildasaldo" to player
            stop
        set {_guild} to {rpg::%{_id}%::guild}
        send "&6&lGUILDA &e%{_guild}%" to player
        send "&7Integrantes: &f%size of {rpg::guild::%{_guild}%::members::*}%" to player

command /guildacriar <text>:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is set:
            send "{@prefix}&cVocê já pertence a uma guilda." to player
            stop
        if {rpg::guild::%arg-1%::leader} is set:
            send "{@prefix}&cJá existe uma guilda com esse nome." to player
            stop
        set {rpg::guild::%arg-1%::leader} to {_id}
        set {rpg::guild::%arg-1%::level} to 1
        set {rpg::guild::%arg-1%::xp} to 0
        set {rpg::guild::%arg-1%::bank} to 0
        set {rpg::%{_id}%::guild} to arg-1
        set {rpg::%{_id}%::guild-role} to "member"
        add {_id} to {rpg::guild::%arg-1%::members::*}
        send "{@prefix}&aGuilda &e%arg-1% &acriada!" to player

command /guildaconvidar <player>:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is not set:
            send "{@prefix}&cVocê não pertence a uma guilda." to player
            stop
        set {_guild} to {rpg::%{_id}%::guild}
        if {rpg::guild::%{_guild}%::leader} is not {_id}:
            if {rpg::%{_id}%::guild-role} is not "officer":
                send "{@prefix}&cSomente líder ou oficial pode convidar jogadores." to player
                stop
        set {_target} to "%uuid of arg-1%"
        if {rpg::%{_target}%::guild} is set:
            send "{@prefix}&cEsse jogador já está em uma guilda." to player
            stop
        set {rpg::guild-invite::%{_target}%} to {_guild}
        send "{@prefix}&aConvite enviado para %arg-1%." to player
        send "{@prefix}&eVocê foi convidado para a guilda &6%{_guild}%&e. Use /guildaaceitar." to arg-1

command /guildaaceitar:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is set:
            send "{@prefix}&cVocê já pertence a uma guilda." to player
            stop
        if {rpg::guild-invite::%{_id}%} is not set:
            send "{@prefix}&cVocê não possui convites pendentes." to player
            stop
        set {_guild} to {rpg::guild-invite::%{_id}%}
        set {rpg::%{_id}%::guild} to {_guild}
        set {rpg::%{_id}%::guild-role} to "member"
        add {_id} to {rpg::guild::%{_guild}%::members::*}
        delete {rpg::guild-invite::%{_id}%}
        send "{@prefix}&aVocê entrou na guilda &e%{_guild}%&a!" to player

command /guildasair:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is not set:
            send "{@prefix}&cVocê não pertence a uma guilda." to player
            stop
        set {_guild} to {rpg::%{_id}%::guild}
        if {rpg::guild::%{_guild}%::leader} is {_id}:
            send "{@prefix}&cTransfira a liderança com /guildatransferir antes de sair." to player
            stop
        remove {_id} from {rpg::guild::%{_guild}%::members::*}
        delete {rpg::%{_id}%::guild}
        delete {rpg::%{_id}%::guild-role}
        send "{@prefix}&aVocê saiu da guilda." to player

command /guildainfo:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::guild} is not set:
            send "{@prefix}&cVocê não pertence a uma guilda." to player
            stop
        set {_guild} to {rpg::%{_id}%::guild}
        send "&6&lGUILDA &e%{_guild}%" to player
        send "&7Líder UUID: &f%{rpg::guild::%{_guild}%::leader}%" to player
        send "&7Integrantes: &f%size of {rpg::guild::%{_guild}%::members::*}%" to player
