options:
    prefix: &8[&6RPG Revolution&8] &r

# Raid cooperativa de chefe: usa o grupo existente, escala vida e recompensa pela dificuldade.
command /raidchefe [<text>]:
    trigger:
        set {_id} to "%uuid of player%"
        set {_party} to {rpg::%{_id}%::party}
        if {_party} is not set:
            send "{@prefix}&cVocê precisa estar em um grupo." to player
            stop
        if {_party} is not {_id}:
            send "{@prefix}&cSomente o líder do grupo pode iniciar, consultar ou cancelar a raid." to player
            stop
        if arg-1 is "status":
            if {rpg::raidboss::%{_party}%::active} is not true:
                send "{@prefix}&cSeu grupo não tem uma raid ativa." to player
                stop
            send "&6&lRAID DO CHEFE &7- Dificuldade: &e%{rpg::raidboss::%{_party}%::difficulty}%" to player
            send "&7Dano total registrado: &f%{rpg::raidboss::%{_party}%::total-damage}%" to player
            loop all players:
                set {_member-id} to "%uuid of loop-player%"
                if {rpg::raidboss::%{_party}%::member::%{_member-id}%} is true:
                    send "&f%loop-player%: &e%{rpg::raidboss::%{_party}%::damage::%{_member-id}%}% dano" to player
            stop
        if arg-1 is "cancelar":
            if {rpg::raidboss::%{_party}%::active} is not true:
                send "{@prefix}&cSeu grupo não tem uma raid ativa." to player
                stop
            loop all entities:
                if {rpg::raidboss::mob-owner::%uuid of loop-entity%} is {_party}:
                    delete {rpg::raidboss::mob-owner::%uuid of loop-entity%}
                    kill loop-entity
            delete {rpg::raidboss::%{_party}%::*}
            broadcast "{@prefix}&eA raid do grupo de %player% foi cancelada."
            stop
        if {rpg::raidboss::%{_party}%::active} is true:
            send "{@prefix}&cSeu grupo já tem uma raid ativa." to player
            stop
        if arg-1 is not "normal" and arg-1 is not "heroica" and arg-1 is not "pesadelo":
            send "{@prefix}&e/raidchefe normal|heroica|pesadelo|status|cancelar" to player
            stop
        set {_difficulty} to arg-1
        set {_minimum} to 10
        set {_health} to 250
        set {_coins} to 500
        set {_xp} to 300
        set {_diamonds} to 2
        if {_difficulty} is "heroica":
            set {_minimum} to 20
            set {_health} to 500
            set {_coins} to 1000
            set {_xp} to 600
            set {_diamonds} to 4
        else if {_difficulty} is "pesadelo":
            set {_minimum} to 35
            set {_health} to 800
            set {_coins} to 1800
            set {_xp} to 1000
            set {_diamonds} to 7
        delete {rpg::raidboss::%{_party}%::member::*}
        delete {rpg::raidboss::%{_party}%::damage::*}
        set {_count} to 0
        loop all players:
            set {_member-id} to "%uuid of loop-player%"
            if {rpg::%{_member-id}%::party} is {_party}:
                if world of loop-player is world of player:
                    if distance between loop-player and player <= 24:
                        set {_level} to {rpg::%{_member-id}%::level}
                        if {_level} < {_minimum}:
                            send "{@prefix}&c%loop-player% precisa estar no nível %{_minimum}% para esta dificuldade." to player
                            delete {rpg::raidboss::%{_party}%::member::*}
                            stop
                        add 1 to {_count}
                        set {rpg::raidboss::%{_party}%::member::%{_member-id}%} to true
                        set {rpg::raidboss::%{_party}%::damage::%{_member-id}%} to 0
        if {_count} < 2:
            delete {rpg::raidboss::%{_party}%::member::*}
            send "{@prefix}&cA raid exige pelo menos 2 membros online, próximos e no mesmo mundo." to player
            stop
        set {rpg::raidboss::%{_party}%::active} to true
        set {rpg::raidboss::%{_party}%::difficulty} to {_difficulty}
        set {rpg::raidboss::%{_party}%::total-damage} to 0
        set {rpg::raidboss::%{_party}%::coins} to {_coins}
        set {rpg::raidboss::%{_party}%::xp} to {_xp}
        set {rpg::raidboss::%{_party}%::diamonds} to {_diamonds}
        spawn ravager at location of player
        set {_boss} to last spawned entity
        set name of {_boss} to "&4&lCOLOSSO DA RAID"
        set max health of {_boss} to {_health}
        set health of {_boss} to {_health}
        set {rpg::raidboss::mob-owner::%uuid of {_boss}%} to {_party}
        set {rpg::raidboss::%{_party}%::boss-id} to "%uuid of {_boss}%"
        apply resistance 1 to {_boss} for 999999 seconds
        loop all players:
            if {rpg::raidboss::%{_party}%::member::%uuid of loop-player%} is true:
                send "{@prefix}&4&lRAID INICIADA! &7Dificuldade: &e%{_difficulty}%&7. Ataquem juntos e confiram /raidchefe status." to loop-player

on damage of ravager:
    set {_party} to {rpg::raidboss::mob-owner::%uuid of victim%}
    if {_party} is set:
        if attacker is a player:
            set {_attacker-id} to "%uuid of attacker%"
            if {rpg::raidboss::%{_party}%::member::%{_attacker-id}%} is true:
                add damage to {rpg::raidboss::%{_party}%::damage::%{_attacker-id}%}
                add damage to {rpg::raidboss::%{_party}%::total-damage}

on death of ravager:
    set {_party} to {rpg::raidboss::mob-owner::%uuid of victim%}
    if {_party} is set:
        delete {rpg::raidboss::mob-owner::%uuid of victim%}
        set {_total} to {rpg::raidboss::%{_party}%::total-damage}
        if {_total} <= 0:
            set {_total} to 1
        set {_coins} to {rpg::raidboss::%{_party}%::coins}
        set {_xp} to {rpg::raidboss::%{_party}%::xp}
        set {_diamonds} to {rpg::raidboss::%{_party}%::diamonds}
        broadcast "{@prefix}&6&lCOLOSSO DA RAID DERROTADO! &aRecompensas distribuídas por contribuição."
        loop all players:
            set {_member-id} to "%uuid of loop-player%"
            if {rpg::raidboss::%{_party}%::member::%{_member-id}%} is true:
                set {_damage} to {rpg::raidboss::%{_party}%::damage::%{_member-id}%}
                if {_damage} > 0:
                    set {_share} to {_damage} / {_total}
                    set {_earned-coins} to round({_coins} * {_share})
                    set {_earned-xp} to round({_xp} * {_share})
                    set {_earned-diamonds} to round({_diamonds} * {_share})
                    if {_earned-coins} > 0:
                        add {_earned-coins} to {rpg::%{_member-id}%::coins}
                    if {_earned-xp} > 0:
                        rpg_add_xp(loop-player, {_earned-xp})
                    if {_earned-diamonds} > 0:
                        give loop-player {_earned-diamonds} diamonds
                    rpg_give_boss_loot(loop-player)
                    send "{@prefix}&aSua contribuição: %{_damage}% dano. Recompensa: %{_earned-coins}% moedas, %{_earned-xp}% XP, %{_earned-diamonds}% diamantes e 1 item de chefe." to loop-player
                else:
                    send "{@prefix}&7Você não causou dano e não recebeu recompensa da raid." to loop-player
        delete {rpg::raidboss::%{_party}%::*}

on quit:
    set {_id} to "%uuid of player%"
    set {_party} to {rpg::%{_id}%::party}
    if {_party} is set:
        if {rpg::raidboss::%{_party}%::active} is true:
            if {_party} is {_id}:
                loop all entities:
                    if {rpg::raidboss::mob-owner::%uuid of loop-entity%} is {_party}:
                        delete {rpg::raidboss::mob-owner::%uuid of loop-entity%}
                        kill loop-entity
                delete {rpg::raidboss::%{_party}%::*}
                loop all players:
                    if {rpg::%uuid of loop-player%::party} is {_party}:
                        send "{@prefix}&cA raid foi encerrada porque o líder desconectou." to loop-player
