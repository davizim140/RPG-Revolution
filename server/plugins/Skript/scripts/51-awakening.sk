options:
    prefix: &8[&6RPG Revolution&8] &r

# Despertar raro: 3% ao escolher Assassino pela primeira vez.
# O poder é permanente e não pode ser obtido novamente por comando.
command /despertar:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::awakening} is "monarca_sombras":
            send "&5&lDESPERTAR: MONARCA DAS SOMBRAS" to player
            send "&7Classe: &fassassino despertado" to player
            send "&7Passiva: &f+2 de dano em ataques corpo a corpo." to player
            send "&7Habilidade: &f/sombra (35 mana, recarga de 30 segundos)." to player
            send "&7Poder: &fvelocidade, força e invisibilidade por 10 segundos." to player
        else if {rpg::%{_id}%::awakening} is "colosso":
            send "&6&lDESPERTAR: COLOSSO" to player
            send "&7Classe: &fGuerreiro despertado" to player
            send "&7Passiva: &f+2 de dano corpo a corpo." to player
            send "&7Habilidade: &f/furia (35 mana, recarga de 30 segundos)." to player
            send "&7Poder: &fforça III e resistência II por 10 segundos." to player
        else if {rpg::%{_id}%::awakening} is "arquimago":
            send "&5&lDESPERTAR: ARQUIMAGO" to player
            send "&7Classe: &fMago despertado" to player
            send "&7Passiva: &f+2 de dano mágico corpo a corpo." to player
            send "&7Habilidade: &f/arcano (40 mana, recarga de 30 segundos)." to player
            send "&7Poder: &fregeneração II e resistência I por 12 segundos." to player
        else if {rpg::%{_id}%::awakening} is "olho_celestial":
            send "&b&lDESPERTAR: OLHO CELESTIAL" to player
            send "&7Classe: &fArqueiro despertado" to player
            send "&7Passiva: &f+3 de dano com arco." to player
            send "&7Habilidade: &f/precisao (30 mana, recarga de 25 segundos)." to player
            send "&7Poder: &fvelocidade III e visão noturna por 15 segundos." to player
        else:
            send "{@prefix}&7Você ainda não despertou um poder especial." to player
            send "&8Há uma chance rara de despertar ao escolher sua classe." to player

command /sombra:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::class} is not "assassino":
            send "{@prefix}&cEste poder pertence ao Assassino." to player
            stop
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cVocê não possui o despertar Monarca das Sombras." to player
            stop
        if {rpg::%{_id}%::mana} < 35:
            send "{@prefix}&cVocê precisa de 35 de mana." to player
            stop
        if {rpg::%{_id}%::skill-cooldown} > 0:
            send "{@prefix}&cA habilidade recarrega em %{rpg::%{_id}%::skill-cooldown}% segundos." to player
            stop
        remove 35 from {rpg::%{_id}%::mana}
        set {rpg::%{_id}%::skill-cooldown} to 30
        apply speed 3 to player for 10 seconds
        apply strength 2 to player for 10 seconds
        apply invisibility 1 to player for 10 seconds
        send "{@prefix}&5&lDOMÍNIO DAS SOMBRAS! &7Você se tornou uma sombra impossível de alcançar." to player

on damage:
    attacker is a player
    set {_id} to "%uuid of attacker%"
    if {rpg::%{_id}%::awakening} is "monarca_sombras":
        increase damage by 2

command /furia:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::class} is not "guerreiro":
            send "{@prefix}&cEste poder pertence ao Guerreiro." to player
            stop
        if {rpg::%{_id}%::awakening} is not "colosso":
            send "{@prefix}&cVocê não possui o despertar Colosso." to player
            stop
        if {rpg::%{_id}%::mana} < 35:
            send "{@prefix}&cVocê precisa de 35 de mana." to player
            stop
        if {rpg::%{_id}%::skill-cooldown} > 0:
            send "{@prefix}&cA habilidade recarrega em %{rpg::%{_id}%::skill-cooldown}% segundos." to player
            stop
        remove 35 from {rpg::%{_id}%::mana}
        set {rpg::%{_id}%::skill-cooldown} to 30
        apply strength 3 to player for 10 seconds
        apply resistance 2 to player for 10 seconds
        send "{@prefix}&6&lFÚRIA DO COLOSSO! &7Seu poder físico foi ampliado." to player

command /arcano:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::class} is not "mago":
            send "{@prefix}&cEste poder pertence ao Mago." to player
            stop
        if {rpg::%{_id}%::awakening} is not "arquimago":
            send "{@prefix}&cVocê não possui o despertar Arquimago." to player
            stop
        if {rpg::%{_id}%::mana} < 40:
            send "{@prefix}&cVocê precisa de 40 de mana." to player
            stop
        if {rpg::%{_id}%::skill-cooldown} > 0:
            send "{@prefix}&cA habilidade recarrega em %{rpg::%{_id}%::skill-cooldown}% segundos." to player
            stop
        remove 40 from {rpg::%{_id}%::mana}
        set {rpg::%{_id}%::skill-cooldown} to 30
        apply regeneration 2 to player for 12 seconds
        apply resistance 1 to player for 12 seconds
        send "{@prefix}&5&lASCENSÃO ARCANA! &7A energia arcana envolve seu corpo." to player

command /precisao:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::class} is not "arqueiro":
            send "{@prefix}&cEste poder pertence ao Arqueiro." to player
            stop
        if {rpg::%{_id}%::awakening} is not "olho_celestial":
            send "{@prefix}&cVocê não possui o despertar Olho Celestial." to player
            stop
        if {rpg::%{_id}%::mana} < 30:
            send "{@prefix}&cVocê precisa de 30 de mana." to player
            stop
        if {rpg::%{_id}%::skill-cooldown} > 0:
            send "{@prefix}&cA habilidade recarrega em %{rpg::%{_id}%::skill-cooldown}% segundos." to player
            stop
        remove 30 from {rpg::%{_id}%::mana}
        set {rpg::%{_id}%::skill-cooldown} to 25
        apply speed 3 to player for 15 seconds
        apply night vision 1 to player for 15 seconds
        send "{@prefix}&b&lOLHO CELESTIAL! &7Sua percepção e precisão foram ampliadas." to player

on damage:
    attacker is a player
    set {_id} to "%uuid of attacker%"
    if {rpg::%{_id}%::awakening} is "colosso":
        if attacker's tool is not bow:
            increase damage by 2
    if {rpg::%{_id}%::awakening} is "arquimago":
        increase damage by 2
    if {rpg::%{_id}%::awakening} is "olho_celestial":
        if attacker's tool is bow:
            increase damage by 3

# Invocação de três soldados especializados por 45 segundos.
command /invocar:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::class} is not "assassino":
            send "{@prefix}&cEste poder pertence ao Assassino." to player
            stop
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cVocê não possui o despertar Monarca das Sombras." to player
            stop
        if {rpg::%{_id}%::mana} < 50:
            send "{@prefix}&cVocê precisa de 50 de mana." to player
            stop
        if {rpg::%{_id}%::skill-cooldown} > 0:
            send "{@prefix}&cA habilidade recarrega em %{rpg::%{_id}%::skill-cooldown}% segundos." to player
            stop
        loop 3 times:
            if {rpg::%{_id}%::shadow::%loop-number%} is set:
                if {rpg::%{_id}%::shadow::%loop-number%} is alive:
                    send "{@prefix}&cVocê já possui soldados de sombra ativos." to player
                    stop
                delete {rpg::%{_id}%::shadow::%loop-number%}
        remove 50 from {rpg::%{_id}%::mana}
        set {rpg::%{_id}%::skill-cooldown} to 60
        set {_level} to {rpg::%{_id}%::level}
        if {_level} >= 50:
            set {_rank} to "S"
            set {_rankName} to "&dElite"
        else if {_level} >= 25:
            set {_rank} to "A"
            set {_rankName} to "&cVeterano"
        else if {_level} >= 10:
            set {_rank} to "B"
            set {_rankName} to "&6Experiente"
        else:
            set {_rank} to "C"
            set {_rankName} to "&7Novato"
        loop 3 times:
            if loop-number is 1:
                spawn an iron golem at location of player
                set {_role} to "TANQUE"
            else if loop-number is 2:
                spawn a wither skeleton at location of player
                set {_role} to "GUERREIRO"
            else:
                spawn a skeleton at location of player
                set {_role} to "ARQUEIRO"
            set {_soldier} to last spawned entity
            set name of {_soldier} to "&5%{_role}% &8| &fRank %{_rank}%"
            apply speed 1 to {_soldier} for 45 seconds
            if {_role} is "TANQUE":
                apply resistance 2 to {_soldier} for 45 seconds
                apply slowness 1 to {_soldier} for 45 seconds
                if {_rank} is "A":
                    apply resistance 3 to {_soldier} for 45 seconds
                else if {_rank} is "S":
                    apply resistance 4 to {_soldier} for 45 seconds
            else if {_role} is "GUERREIRO":
                if {_rank} is "B":
                    apply strength 1 to {_soldier} for 45 seconds
                else if {_rank} is "A":
                    apply strength 2 to {_soldier} for 45 seconds
                    apply resistance 1 to {_soldier} for 45 seconds
                else if {_rank} is "S":
                    apply strength 3 to {_soldier} for 45 seconds
                    apply resistance 2 to {_soldier} for 45 seconds
            else:
                apply speed 2 to {_soldier} for 45 seconds
                if {_rank} is "B":
                    apply strength 1 to {_soldier} for 45 seconds
                else if {_rank} is "A":
                    apply strength 2 to {_soldier} for 45 seconds
                else if {_rank} is "S":
                    apply strength 3 to {_soldier} for 45 seconds
            set {rpg::%{_id}%::shadow::%loop-number%} to {_soldier}
        send "{@prefix}&5&lEXÉRCITO DAS SOMBRAS! &7Tanque, guerreiro e arqueiro de rank &f%{_rank}% &7invocados por 45 segundos." to player
        wait 45 seconds
        loop 3 times:
            if {rpg::%{_id}%::shadow::%loop-number%} is set:
                if {rpg::%{_id}%::shadow::%loop-number%} is alive:
                    kill {rpg::%{_id}%::shadow::%loop-number%}
                delete {rpg::%{_id}%::shadow::%loop-number%}

command /sombras:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cVocê não possui o despertar Monarca das Sombras." to player
            stop
        set {_count} to 0
        loop 3 times:
            if {rpg::%{_id}%::shadow::%loop-number%} is set:
                if {rpg::%{_id}%::shadow::%loop-number%} is alive:
                    add 1 to {_count}
        set {_level} to {rpg::%{_id}%::level}
        if {_level} >= 50:
            set {_rank} to "S &d(Elite)"
        else if {_level} >= 25:
            set {_rank} to "A &c(Veterano)"
        else if {_level} >= 10:
            set {_rank} to "B &6(Experiente)"
        else:
            set {_rank} to "C &7(Novato)"
        send "&5&lEXÉRCITO DAS SOMBRAS" to player
        send "&7Nível do Monarca: &f%{_level}%" to player
        send "&7Evolução dos soldados: &f%{_rank}%" to player
        send "&7Soldados ativos: &f%{_count}%&7/3" to player
        send "&7Invocação: &f/invocar &7(50 mana, recarga de 60 segundos)." to player

# Os soldados priorizam criaturas atacadas pelo Monarca ou que o atacam.
on damage:
    attacker is a player
    set {_ownerId} to "%uuid of attacker%"
    if {rpg::%{_ownerId}%::awakening} is "monarca_sombras":
        if victim is not a player:
            loop 3 times:
                if {rpg::%{_ownerId}%::shadow::%loop-number%} is set:
                    if {rpg::%{_ownerId}%::shadow::%loop-number%} is alive:
                        set target of {rpg::%{_ownerId}%::shadow::%loop-number%} to victim

on damage:
    victim is a player
    set {_ownerId} to "%uuid of victim%"
    if {rpg::%{_ownerId}%::awakening} is "monarca_sombras":
        if attacker is a living entity:
            loop 3 times:
                if {rpg::%{_ownerId}%::shadow::%loop-number%} is set:
                    if {rpg::%{_ownerId}%::shadow::%loop-number%} is alive:
                        set target of {rpg::%{_ownerId}%::shadow::%loop-number%} to attacker

on damage:
    attacker is an entity
    loop all players:
        set {_ownerId} to "%uuid of loop-player%"
        loop 3 times:
            if {rpg::%{_ownerId}%::shadow::%loop-number%} is attacker:
                if victim is loop-player:
                    cancel event

# Extração permanente: o Monarca pode erguer uma sombra de um inimigo derrotado.
# As sombras extraídas ocupam até cinco espaços e permanecem até serem destruídas/libertadas.
command /exercito:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cSomente o Monarca das Sombras pode comandar este exército." to player
            stop
        set {_count} to 0
        loop 5 times:
            if {rpg::%{_id}%::permanent-shadow::%loop-number%} is set:
                if {rpg::%{_id}%::permanent-shadow::%loop-number%} is alive:
                    add 1 to {_count}
                else:
                    delete {rpg::%{_id}%::permanent-shadow::%loop-number%}
        send "&5&lEXÉRCITO PERMANENTE" to player
        send "&7Soldados: &f%{_count}%&7/5" to player
        loop 5 times:
            if {rpg::%{_id}%::permanent-shadow::%loop-number%} is set:
                if {rpg::%{_id}%::permanent-shadow::%loop-number%} is alive:
                    send "&8- &5%name of {rpg::%{_id}%::permanent-shadow::%loop-number%}%" to player
        send "&7Para libertar: &f/libertar <1-5>" to player

command /libertar <number>:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cSomente o Monarca pode libertar sombras." to player
            stop
        if arg-1 is not between 1 and 5:
            send "{@prefix}&cEscolha um espaço de 1 a 5." to player
            stop
        set {_slot} to arg-1
        if {rpg::%{_id}%::permanent-shadow::%{_slot}%} is not set:
            send "{@prefix}&cEsse espaço está vazio." to player
            stop
        if {rpg::%{_id}%::permanent-shadow::%{_slot}%} is alive:
            kill {rpg::%{_id}%::permanent-shadow::%{_slot}%}
        delete {rpg::%{_id}%::permanent-shadow::%{_slot}%}
        delete {rpg::%{_id}%::permanent-shadow-level::%{_slot}%}
        delete {rpg::%{_id}%::permanent-shadow-xp::%{_slot}%}
        send "{@prefix}&7A sombra do espaço &f%{_slot}% &7foi libertada." to player

# Chance de 15% ao derrotar um monstro; cada Monarca pode manter até cinco.
on death of monster:
    attacker is a player
    set {_id} to "%uuid of attacker%"
    if {rpg::%{_id}%::awakening} is "monarca_sombras":
        set {_freeSlot} to 0
        set {_count} to 0
        loop 5 times:
            if {rpg::%{_id}%::permanent-shadow::%loop-number%} is set:
                if {rpg::%{_id}%::permanent-shadow::%loop-number%} is alive:
                    add 1 to {_count}
                else:
                    delete {rpg::%{_id}%::permanent-shadow::%loop-number%}
            else if {_freeSlot} is 0:
                set {_freeSlot} to loop-number
        if {_count} >= 5:
            stop
        if {_freeSlot} is 0:
            stop
        chance of 15%:
            set {_fallenName} to name of victim
            if {_fallenName} is not set:
                set {_fallenName} to "%type of victim%"
            spawn a wither skeleton at location of victim
            set {_shadow} to last spawned entity
            set name of {_shadow} to "&5Sombra de %{_fallenName}%"
            set {rpg::%{_id}%::permanent-shadow::%{_freeSlot}%} to {_shadow}
            set {rpg::%{_id}%::permanent-shadow-owner::%uuid of {_shadow}%} to {_id}
            set {rpg::shadow-owner::%uuid of {_shadow}%} to {_id}
            set {rpg::%{_id}%::permanent-shadow-level::%{_freeSlot}%} to 1
            set {rpg::%{_id}%::permanent-shadow-xp::%{_freeSlot}%} to 0
            apply resistance 1 to {_shadow} for 999999 seconds
            send "{@prefix}&5&lRESSURREIÇÃO! &7Você ergueu &f%{_fallenName}% &7como sombra permanente. (&f%{_count}%&7/5)" to attacker

# Sombras permanentes protegem o Monarca e atacam o alvo que o feriu.
on damage:
    attacker is a player
    set {_ownerId} to "%uuid of attacker%"
    if {rpg::%{_ownerId}%::awakening} is "monarca_sombras":
        if victim is not a player:
            loop 5 times:
                if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is set:
                    if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is alive:
                        set target of {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} to victim

on damage:
    victim is a player
    set {_ownerId} to "%uuid of victim%"
    if {rpg::%{_ownerId}%::awakening} is "monarca_sombras":
        if attacker is a living entity:
            loop 5 times:
                if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is set:
                    if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is alive:
                        set target of {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} to attacker

# Impede que uma sombra permanente cause dano ao próprio Monarca.
on damage:
    attacker is a wither skeleton
    victim is a player
    set {_victimId} to "%uuid of victim%"
    if {rpg::%{_victimId}%::awakening} is "monarca_sombras":
        loop 5 times:
            if {rpg::%{_victimId}%::permanent-shadow::%loop-number%} is attacker:
                cancel event

# Libera automaticamente o espaço quando uma sombra permanente morre.
on death of wither skeleton:
    loop all players:
        set {_ownerId} to "%uuid of loop-player%"
        loop 5 times:
            if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is victim:
                delete {rpg::%{_ownerId}%::permanent-shadow::%loop-number%}
# Progressão individual das sombras permanentes.
# Cada sombra ganha 1 XP por criatura derrotada; a cada 5 XP sobe um nível.
# Os bônus são reaplicados no evento de evolução.
on death of monster:
    attacker is a wither skeleton
    set {_shadowId} to "%uuid of attacker%"
    set {_ownerId} to {rpg::shadow-owner::%{_shadowId}%}
    if {_ownerId} is set:
        loop 5 times:
            if {rpg::%{_ownerId}%::permanent-shadow::%loop-number%} is attacker:
                add 1 to {rpg::%{_ownerId}%::permanent-shadow-xp::%loop-number%}
                set {_xp} to {rpg::%{_ownerId}%::permanent-shadow-xp::%loop-number%}
                set {_level} to {rpg::%{_ownerId}%::permanent-shadow-level::%loop-number%}
                if {_level} is not set:
                    set {_level} to 1
                if {_xp} >= {_level} * 5:
                    if {_level} < 10:
                        add 1 to {_level}
                        set {rpg::%{_ownerId}%::permanent-shadow-level::%loop-number%} to {_level}
                        if {_level} >= 2:
                            apply speed 1 to attacker for 999999 seconds
                        if {_level} >= 4:
                            apply strength 1 to attacker for 999999 seconds
                        if {_level} >= 7:
                            apply resistance 1 to attacker for 999999 seconds
                        if {_level} >= 10:
                            apply strength 2 to attacker for 999999 seconds
                        loop all players:
                            if "%uuid of loop-player%" is {_ownerId}:
                                send "&5&lSOMBRA EVOLUÍDA! &7Uma sombra permanente alcançou o nível &f%{_level}%&7." to loop-player

command /sombranivel <number>:
    trigger:
        set {_id} to "%uuid of player%"
        if {rpg::%{_id}%::awakening} is not "monarca_sombras":
            send "{@prefix}&cSomente o Monarca pode consultar suas sombras." to player
            stop
        if arg-1 is not between 1 and 5:
            send "{@prefix}&cEscolha um espaço de 1 a 5." to player
            stop
        set {_slot} to arg-1
        if {rpg::%{_id}%::permanent-shadow::%{_slot}%} is not set:
            send "{@prefix}&cEsse espaço está vazio." to player
            stop
        set {_level} to {rpg::%{_id}%::permanent-shadow-level::%{_slot}%}
        if {_level} is not set:
            set {_level} to 1
        set {_xp} to {rpg::%{_id}%::permanent-shadow-xp::%{_slot}%}
        if {_xp} is not set:
            set {_xp} to 0
        send "&5&lSTATUS DA SOMBRA" to player
        send "&7Nível: &f%{_level}%&7/10" to player
        send "&7Experiência: &f%{_xp}%" to player
        send "&7Próximo nível: &f%{_level} * 5% XP total" to player
