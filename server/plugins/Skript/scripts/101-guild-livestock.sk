options:
    prefix: &8[&6RPG Revolution&8] &r
    territory-radius: 16

# Progressao individual de pecuaria dentro do territorio da propria guilda.
function rpg_livestock_xp(p: player, amount: number):
    set {_uuid} to "%uuid of {_p}%"
    if {rpg::%{_uuid}%::livestock::level} is not set:
        set {rpg::%{_uuid}%::livestock::level} to 1
    if {rpg::%{_uuid}%::livestock::xp} is not set:
        set {rpg::%{_uuid}%::livestock::xp} to 0
    add {_amount} to {rpg::%{_uuid}%::livestock::xp}
    while {rpg::%{_uuid}%::livestock::xp} >= ({rpg::%{_uuid}%::livestock::level} * 100):
        set {_needed} to {rpg::%{_uuid}%::livestock::level} * 100
        remove {_needed} from {rpg::%{_uuid}%::livestock::xp}
        add 1 to {rpg::%{_uuid}%::livestock::level}
        add 25 to {rpg::%{_uuid}%::coins}
        if {rpg::%{_uuid}%::livestock::level} >= 15:
            set {rpg::%{_uuid}%::livestock::title} to "Mestre Pecuarista"
        else if {rpg::%{_uuid}%::livestock::level} >= 10:
            set {rpg::%{_uuid}%::livestock::title} to "Criador Veterano"
        else if {rpg::%{_uuid}%::livestock::level} >= 5:
            set {rpg::%{_uuid}%::livestock::title} to "Tratador Experiente"
        else:
            set {rpg::%{_uuid}%::livestock::title} to "Aprendiz de Criador"
        send "{@prefix}&aPecuária subiu para o nível &e%{rpg::%{_uuid}%::livestock::level}%&a! +25 moedas." to {_p}
        if {rpg::%{_uuid}%::livestock::level} mod 5 is 0:
            add 75 to {rpg::%{_uuid}%::coins}
            send "{@prefix}&6Título desbloqueado: &e%{rpg::%{_uuid}%::livestock::title}%&6! Bônus: &e+75 moedas." to {_p}

# Alimentar animais: XP somente em territorio da guilda do jogador.
on right click on living entity:
    set {_uuid} to "%uuid of player%"
    set {_guild} to {rpg::%{_uuid}%::guild}
    if {_guild} is not set:
        stop
    set {_food} to player's tool
    set {_valid} to false
    if event-entity is cow or sheep or goat or mooshroom:
        if {_food} is wheat:
            set {_valid} to true
    else if event-entity is pig:
        if {_food} is carrot or potato or beetroot:
            set {_valid} to true
    else if event-entity is chicken:
        if {_food} is wheat seeds or melon seeds or pumpkin seeds or beetroot seeds or torchflower seeds or pitcher pod:
            set {_valid} to true
    else if event-entity is rabbit:
        if {_food} is carrot or golden carrot or dandelion:
            set {_valid} to true
    if {_valid} is false:
        stop
    set {_entityId} to "%uuid of event-entity%"
    if {rpg::livestock::feed-cooldown::%{_entityId}%} is set:
        stop
    set {_loc} to location of event-entity
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of {_loc}%":
            set {_dx} to (x-coordinate of {_loc}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_loc}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                if {rpg::territory::%{_territory}%::guild} is {_guild}:
                    set {_beforeAmount} to amount of player's tool
                    set {rpg::livestock::feed-cooldown::%{_entityId}%} to true
                    wait 1 tick
                    if amount of player's tool < {_beforeAmount}:
                        add 1 to {rpg::%{_uuid}%::livestock::feedings}
                        rpg_livestock_xp(player, 2)
                        send "{@prefix}&aAnimal alimentado! &e+2 XP de pecuária." to player
                    wait 30 seconds
                    delete {rpg::livestock::feed-cooldown::%{_entityId}%}
                stop

# Reproducao concluida: premia quem alimentou o casal, se ocorrer na propria area da guilda.
on breeding:
    if breeder is not a player:
        stop
    set {_p} to breeder
    set {_uuid} to "%uuid of {_p}%"
    set {_guild} to {rpg::%{_uuid}%::guild}
    if {_guild} is not set:
        stop
    set {_loc} to location of breeding mother
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of {_loc}%":
            set {_dx} to (x-coordinate of {_loc}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_loc}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                if {rpg::territory::%{_territory}%::guild} is {_guild}:
                    add 1 to {rpg::%{_uuid}%::livestock::breeds}
                    add 1 to {rpg::guild::%{_guild}%::livestock::breeds}
                    rpg_livestock_xp({_p}, 20)
                    send "{@prefix}&aReprodução registrada! &e+20 XP de pecuária." to {_p}
                stop

command /guildpecuaria:
    trigger:
        set {_uuid} to "%uuid of player%"
        set {_guild} to {rpg::%{_uuid}%::guild}
        if {_guild} is not set:
            send "{@prefix}&cVocê precisa pertencer a uma guilda." to player
            stop
        set {_level} to {rpg::%{_uuid}%::livestock::level}
        set {_xp} to {rpg::%{_uuid}%::livestock::xp}
        set {_title} to {rpg::%{_uuid}%::livestock::title}
        set {_feedings} to {rpg::%{_uuid}%::livestock::feedings}
        set {_breeds} to {rpg::%{_uuid}%::livestock::breeds}
        set {_guildBreeds} to {rpg::guild::%{_guild}%::livestock::breeds}
        if {_level} is not set:
            set {_level} to 1
        if {_xp} is not set:
            set {_xp} to 0
        if {_title} is not set:
            set {_title} to "Aprendiz de Criador"
        if {_feedings} is not set:
            set {_feedings} to 0
        if {_breeds} is not set:
            set {_breeds} to 0
        if {_guildBreeds} is not set:
            set {_guildBreeds} to 0
        set {_needed} to {_level} * 100
        send "&6&lPECUÁRIA DA GUILDA" to player
        send "&eNível: &f%{_level}% &8| &eXP: &f%{_xp}%&7/&f%{_needed}%" to player
        send "&eTítulo: &6%{_title}%" to player
        send "&eAlimentações válidas: &f%{_feedings}% &8| &eReproduções: &f%{_breeds}%" to player
        send "&eReproduções da guilda: &f%{_guildBreeds}%" to player
        send "&7Alimentar: 2 XP (uma vez por animal a cada 30s). Reprodução: 20 XP."
