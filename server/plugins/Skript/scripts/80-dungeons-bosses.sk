options:
    prefix: &8[&6RPG Revolution&8] &r

# Encontro individual. O UUID do chefe vincula a recompensa ao jogador que iniciou.
command /masmorra [<text>]:
    aliases: /dungeon
    trigger:
        set {_id} to "%uuid of player%"
        if arg-1 is "cancelar" or "sair":
            if {rpg::dungeon::%{_id}%::active} is not true:
                send "{@prefix}&cVocê não tem um encontro ativo." to player
                stop
            set {_bossId} to {rpg::dungeon::%{_id}%::boss}
            delete {rpg::dungeon::%{_id}%::active}
            delete {rpg::dungeon::%{_id}%::boss}
            loop all entities:
                if "%uuid of loop-entity%" is {_bossId}:
                    kill loop-entity
            send "{@prefix}&eEncontro cancelado. Você poderá iniciar novamente." to player
            stop
        if arg-1 is set:
            send "{@prefix}&cUso: /masmorra [cancelar]" to player
            stop
        if {rpg::%{_id}%::created} is not true:
            send "{@prefix}&cSeu personagem não foi inicializado." to player
            stop
        if {rpg::%{_id}%::level} < 5:
            send "{@prefix}&cVocê precisa alcançar o nível 5 para enfrentar a masmorra." to player
            stop
        if {rpg::dungeon::%{_id}%::active} is true:
            send "{@prefix}&cVocê já iniciou um encontro. Use /masmorra cancelar para desistir." to player
            stop
        spawn zombie at location of player
        set {_boss} to last spawned entity
        set name of {_boss} to "&4Chefe da Masmorra"
        set max health of {_boss} to 60
        set health of {_boss} to 60
        apply resistance 1 to {_boss} for 999999 seconds
        set {rpg::dungeon::%{_id}%::active} to true
        set {rpg::dungeon::%{_id}%::boss} to "%uuid of {_boss}%"
        send "{@prefix}&4&lCHEFE DA MASMORRA! &cDerrote-o para receber 250 moedas e 150 XP. Use /masmorra cancelar para desistir." to player

# A recompensa é concedida somente ao dono do encontro e uma única vez.
on death of living entity:
    if name of victim is "&4Chefe da Masmorra":
        set {_bossId} to "%uuid of victim%"
        loop all players:
            set {_id} to "%uuid of loop-player%"
            if {rpg::dungeon::%{_id}%::active} is true:
                if {rpg::dungeon::%{_id}%::boss} is {_bossId}:
                    delete {rpg::dungeon::%{_id}%::active}
                    delete {rpg::dungeon::%{_id}%::boss}
                    add 250 to {rpg::%{_id}%::coins}
                    rpg_add_xp(loop-player, 150)
                    send "{@prefix}&6Chefe derrotado! &aRecompensa: 250 moedas e 150 XP." to loop-player

# Evita que um jogador desconectado fique preso a um encontro e deixe o chefe solto.
on quit:
    set {_id} to "%uuid of player%"
    if {rpg::dungeon::%{_id}%::active} is true:
        set {_bossId} to {rpg::dungeon::%{_id}%::boss}
        delete {rpg::dungeon::%{_id}%::active}
        delete {rpg::dungeon::%{_id}%::boss}
        loop all entities:
            if "%uuid of loop-entity%" is {_bossId}:
                kill loop-entity
