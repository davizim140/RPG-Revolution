options:
    prefix: &8[&6RPG Revolution&8] &r
    territory-cost: 500
    territory-radius: 16

# Guild territories are square plots centered on the claiming block.
# Protection is enforced for block breaking, placing and interactions.
command /guildterritorio [<text>]:
    trigger:
        set {_id} to "%uuid of player%"
        set {_guild} to {rpg::%{_id}%::guild}
        if {_guild} is not set:
            send "{@prefix}&cVocê precisa pertencer a uma guilda." to player
            stop
        if arg-1 is not set or arg-1 is "ajuda":
            send "&6&lTERRITÓRIOS DE GUILDA" to player
            send "&e/guildterritorio reivindicar &7- Reivindica a área atual (500 moedas do banco)." to player
            send "&e/guildterritorio info &7- Mostra o território onde você está." to player
            send "&e/guildterritorioguerra &7- Consulta o progresso de captura durante uma guerra." to player
            send "&e/guildterritorio abandonar &7- Abandona o território da sua guilda nesta posição." to player
            stop
        if arg-1 is "reivindicar":
            if {rpg::guild::%{_guild}%::leader} is not {_id}:
                send "{@prefix}&cSomente o líder pode reivindicar territórios." to player
                stop
            set {_count} to size of {rpg::guild::%{_guild}%::territories::*}
            if {_count} >= 3:
                send "{@prefix}&cSua guilda já atingiu o limite de 3 territórios." to player
                stop
            if {rpg::guild::%{_guild}%::bank} < {@territory-cost}:
                send "{@prefix}&cO banco precisa ter {@territory-cost} moedas." to player
                stop
            set {_world} to "%world of player%"
            set {_x} to floor(x-coordinate of player)
            set {_z} to floor(z-coordinate of player)
            loop {rpg::territories::*}:
                set {_territory} to loop-value
                if {rpg::territory::%{_territory}%::world} is {_world}:
                    set {_dx} to {_x} - {rpg::territory::%{_territory}%::x}
                    set {_dz} to {_z} - {rpg::territory::%{_territory}%::z}
                    if abs({_dx}) <= 32 and abs({_dz}) <= 32:
                        send "{@prefix}&cJá existe um território próximo. Escolha outra área." to player
                        stop
            set {_key} to "%{_world}%:%{_x}%:%{_z}%"
            if {rpg::territory::%{_key}%::guild} is set:
                send "{@prefix}&cEsta área já foi reivindicada." to player
                stop
            remove {@territory-cost} from {rpg::guild::%{_guild}%::bank}
            set {rpg::territory::%{_key}%::guild} to {_guild}
            set {rpg::territory::%{_key}%::world} to {_world}
            set {rpg::territory::%{_key}%::x} to {_x}
            set {rpg::territory::%{_key}%::z} to {_z}
            add {_key} to {rpg::territories::*}
            add {_key} to {rpg::guild::%{_guild}%::territories::*}
            send "{@prefix}&aTerritório reivindicado! Custo: {@territory-cost} moedas. Área: 33x33 blocos." to player
            stop
        if arg-1 is "info":
            set {_found} to false
            loop {rpg::territories::*}:
                set {_territory} to loop-value
                if {rpg::territory::%{_territory}%::world} is "%world of player%":
                    set {_dx} to (floor(x-coordinate of player)) - {rpg::territory::%{_territory}%::x}
                    set {_dz} to (floor(z-coordinate of player)) - {rpg::territory::%{_territory}%::z}
                    if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                        set {_owner} to {rpg::territory::%{_territory}%::guild}
                        send "{@prefix}&eTerritório pertencente à guilda &6%{_owner}%&e." to player
                        set {_found} to true
                        stop
            if {_found} is false:
                send "{@prefix}&7Esta área não pertence a nenhuma guilda." to player
            stop
        if arg-1 is "abandonar":
            if {rpg::guild::%{_guild}%::leader} is not {_id}:
                send "{@prefix}&cSomente o líder pode abandonar territórios." to player
                stop
            set {_found} to false
            loop {rpg::guild::%{_guild}%::territories::*}:
                set {_territory} to loop-value
                if {rpg::territory::%{_territory}%::world} is "%world of player%":
                    set {_dx} to (floor(x-coordinate of player)) - {rpg::territory::%{_territory}%::x}
                    set {_dz} to (floor(z-coordinate of player)) - {rpg::territory::%{_territory}%::z}
                    if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                        remove {_territory} from {rpg::territories::*}
                        remove {_territory} from {rpg::guild::%{_guild}%::territories::*}
                        delete {rpg::territory::%{_territory}%::*}
                        send "{@prefix}&aTerritório abandonado. O custo não é reembolsado." to player
                        set {_found} to true
                        stop
            if {_found} is false:
                send "{@prefix}&cSua guilda não possui território nesta posição." to player
            stop
        send "{@prefix}&cSubcomando inválido. Use /guildterritorio ajuda." to player

on break:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                set {_owner} to {rpg::territory::%{_territory}%::guild}
                set {_id} to "%uuid of player%"
                if {rpg::%{_id}%::guild} is not {_owner}:
                    cancel event
                    send "{@prefix}&cÁrea protegida pela guilda &e%{_owner}%&c." to player
                stop

on place:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                set {_owner} to {rpg::territory::%{_territory}%::guild}
                set {_id} to "%uuid of player%"
                if {rpg::%{_id}%::guild} is not {_owner}:
                    cancel event
                    send "{@prefix}&cÁrea protegida pela guilda &e%{_owner}%&c." to player
                stop

on right click:
    if clicked block is set:
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of clicked block%":
                set {_dx} to (x-coordinate of clicked block) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of clicked block) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    set {_owner} to {rpg::territory::%{_territory}%::guild}
                    set {_id} to "%uuid of player%"
                    if {rpg::%{_id}%::guild} is not {_owner}:
                        cancel event
                        send "{@prefix}&cÁrea protegida pela guilda &e%{_owner}%&c." to player
                    stop


# Explosoes nao removem blocos protegidos.
on explode:
    loop event-blocks:
        set {_explosionBlock} to loop-block
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of {_explosionBlock}%":
                set {_dx} to (x-coordinate of {_explosionBlock}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_explosionBlock}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    remove {_explosionBlock} from event-blocks
                    stop

# Pistons nao podem movimentar blocos para dentro ou para fora de territorios.
on piston extend:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop
    loop moved blocks:
        set {_moved} to loop-block
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of {_moved}%":
                set {_dx} to (x-coordinate of {_moved}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_moved}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    cancel event
                    stop

on piston retract:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop
    loop moved blocks:
        set {_moved} to loop-block
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of {_moved}%":
                set {_dx} to (x-coordinate of {_moved}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_moved}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    cancel event
                    stop

# Dispensers e droppers dentro de territorios nao podem disparar itens.
# O evento nao identifica o dono do mecanismo; a regra protege a area
# bloqueando a ativacao de qualquer mecanismo localizado dentro dela.
on dispense:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop

# Bloqueia transporte automatico de itens por funis entre inventarios
# quando a origem ou o destino estiver dentro de um territorio.
on inventory item move:
    set {_source} to location at holder of past event-inventory
    set {_destination} to location at holder of event-inventory
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if world of {_source} is world "%{rpg::territory::%{_territory}%::world}%":
            set {_dx} to (x-coordinate of {_source}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_source}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop
        if world of {_destination} is world "%{rpg::territory::%{_territory}%::world}%":
            set {_dx} to (x-coordinate of {_destination}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_destination}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop

# Impede funis e carrinhos com funil de recolher itens do chao
# quando o inventario coletor esta dentro de um territorio protegido.
# O evento inventory pickup do Skript cobre hoppers e hopper minecarts.
on inventory pickup:
    set {_pickupLocation} to location at holder of event-inventory
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if "%world of {_pickupLocation}%" is {rpg::territory::%{_territory}%::world}:
            set {_dx} to (x-coordinate of {_pickupLocation}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_pickupLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop

# Protege inventarios de entidades, incluindo carrinhos com bau,
# contra abertura por jogadores que nao pertencem a guilda proprietaria.
on inventory open:
    set {_holder} to holder of event-inventory
    if {_holder} is a block or {_holder} is an entity:
        set {_containerLocation} to location of {_holder}
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if "%world of {_containerLocation}%" is {rpg::territory::%{_territory}%::world}:
                set {_dx} to (x-coordinate of {_containerLocation}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_containerLocation}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    set {_owner} to {rpg::territory::%{_territory}%::guild}
                    set {_playerId} to "%uuid of event-player%"
                    if {rpg::%{_playerId}%::guild} is not {_owner}:
                        cancel event
                        send "{@prefix}&cInventário protegido pela guilda &e%{_owner}%&c." to event-player
                    stop

# Protege territorios contra propagacao e inicio de fogo.
# A regra tambem bloqueia fogo natural dentro da area protegida.
on burn:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop

on ignite:
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
            set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop

# Bloqueia fluxo de agua/lava dentro e na borda dos territorios.
# A margem de 1 bloco cobre a origem imediatamente externa que tenta entrar.
on block flow:
    if event-block is water or event-block is lava:
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of event-block%":
                set {_dx} to (x-coordinate of event-block) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of event-block) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} + 1 and abs({_dz}) <= {@territory-radius} + 1:
                    cancel event
                    stop

# Impede dano e destruicao de veiculos que possuem inventario
# (por exemplo, carrinhos com bau ou funil) dentro de territorios.
# A verificacao usa a expressao nativa "inventory of entity"; veiculos
# sem inventario nao sao afetados.
on vehicle damage:
    if inventory of event-vehicle is set:
        set {_vehicleLocation} to location of event-vehicle
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if "%world of {_vehicleLocation}%" is {rpg::territory::%{_territory}%::world}:
                set {_dx} to (x-coordinate of {_vehicleLocation}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_vehicleLocation}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    cancel event
                    stop

# Salvaguarda no evento final de destruicao, inclusive para danos
# causados por fontes que nao sejam jogadores.
on vehicle destroy:
    if inventory of event-vehicle is set:
        set {_vehicleLocation} to location of event-vehicle
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if "%world of {_vehicleLocation}%" is {rpg::territory::%{_territory}%::world}:
                set {_dx} to (x-coordinate of {_vehicleLocation}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_vehicleLocation}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    cancel event
                    stop

# Impede que jogadores de outras guildas recolham itens do chao
# dentro de territorios reivindicados. Membros da guilda proprietaria
# continuam podendo recolher os itens normalmente.
on player pickup:
    set {_dropLocation} to location of event-dropped item
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if "%world of {_dropLocation}%" is {rpg::territory::%{_territory}%::world}:
            set {_dx} to (x-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                set {_owner} to {rpg::territory::%{_territory}%::guild}
                set {_playerId} to "%uuid of event-player%"
                if {rpg::%{_playerId}%::guild} is not {_owner}:
                    cancel event
                    send "{@prefix}&cOs itens desta área estão protegidos pela guilda &e%{_owner}%&c." to event-player
                stop

# Protege itens dropados contra dano por fogo, lava e explosoes.
# O evento de dano de entidade cobre entidades de item no chao.
# Apenas causas ambientais destrutivas sao bloqueadas; ataques de jogadores
# continuam permitidos, respeitando as demais regras de coleta.
on damage of item:
    if damage was caused by fire, burning, lava, block explosion or entity explosion:
        set {_dropLocation} to location of victim
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if "%world of {_dropLocation}%" is {rpg::territory::%{_territory}%::world}:
                set {_dx} to (x-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (z-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    cancel event
                    stop

# Impede que itens dropados atravessem para fora de territorios.
# O evento de movimento de entidades existe no Skript para Paper 1.16.5+.
# A regra protege a fronteira independentemente de quem causou o empurrao;
# o evento nao identifica de forma confiavel o jogador responsavel.
on item move:
    set {_from} to past event-location
    set {_to} to event-location
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if "%world of {_from}%" is {rpg::territory::%{_territory}%::world}:
            set {_dxFrom} to (x-coordinate of {_from}) - {rpg::territory::%{_territory}%::x}
            set {_dzFrom} to (z-coordinate of {_from}) - {rpg::territory::%{_territory}%::z}
            set {_dxTo} to (x-coordinate of {_to}) - {rpg::territory::%{_territory}%::x}
            set {_dzTo} to (z-coordinate of {_to}) - {rpg::territory::%{_territory}%::z}
            if abs({_dxFrom}) <= {@territory-radius} and abs({_dzFrom}) <= {@territory-radius}:
                if abs({_dxTo}) > {@territory-radius} or abs({_dzTo}) > {@territory-radius}:
                    cancel event
                    stop

# Impede que itens dropados dentro de territorios sejam transportados
# por portais do Nether ou do End para fora da area reivindicada.
# O evento entity portal nao inclui jogadores.
on entity portal:
    if event-entity is an item:
        set {_from} to past event-location
        set {_to} to event-location
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if "%world of {_from}%" is {rpg::territory::%{_territory}%::world}:
                set {_dxFrom} to (x-coordinate of {_from}) - {rpg::territory::%{_territory}%::x}
                set {_dzFrom} to (z-coordinate of {_from}) - {rpg::territory::%{_territory}%::z}
                set {_dxTo} to (x-coordinate of {_to}) - {rpg::territory::%{_territory}%::x}
                set {_dzTo} to (z-coordinate of {_to}) - {rpg::territory::%{_territory}%::z}
                if abs({_dxFrom}) <= {@territory-radius} and abs({_dzFrom}) <= {@territory-radius}:
                    if "%world of {_to}%" is not {rpg::territory::%{_territory}%::world}:
                        cancel event
                        stop
                    if abs({_dxTo}) > {@territory-radius} or abs({_dzTo}) > {@territory-radius}:
                        cancel event
                        stop


# Evita que itens de dentro e de fora de um territorio sejam fundidos
# em uma unica pilha na fronteira, o que poderia deslocar a pilha resultante.
# O evento e cancelado somente quando exatamente um dos itens esta protegido.
on item merge:
    set {_firstLocation} to location of event-entity
    set {_secondLocation} to location of future event-entity
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        set {_firstInside} to false
        set {_secondInside} to false
        if "%world of {_firstLocation}%" is {rpg::territory::%{_territory}%::world}:
            set {_dxFirst} to (x-coordinate of {_firstLocation}) - {rpg::territory::%{_territory}%::x}
            set {_dzFirst} to (z-coordinate of {_firstLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_dxFirst}) <= {@territory-radius} and abs({_dzFirst}) <= {@territory-radius}:
                set {_firstInside} to true
        if "%world of {_secondLocation}%" is {rpg::territory::%{_territory}%::world}:
            set {_dxSecond} to (x-coordinate of {_secondLocation}) - {rpg::territory::%{_territory}%::x}
            set {_dzSecond} to (z-coordinate of {_secondLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_dxSecond}) <= {@territory-radius} and abs({_dzSecond}) <= {@territory-radius}:
                set {_secondInside} to true
        if {_firstInside} is not {_secondInside}:
            cancel event
            stop


# Impede o desaparecimento natural de itens dropados dentro de territorios.
# O cancelamento vale apenas enquanto o item estiver na area reivindicada;
# fora dela, o temporizador normal de despawn continua funcionando.
on item despawn:
    set {_dropLocation} to location of event-entity
    loop {rpg::territories::*}:
        set {_territory} to loop-value
        if "%world of {_dropLocation}%" is {rpg::territory::%{_territory}%::world}:
            set {_dx} to (x-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::x}
            set {_dz} to (z-coordinate of {_dropLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                cancel event
                stop


# Limpeza manual e explicita de itens dropados no territorio atual.
# Requer permissao administrativa e a palavra CONFIRMAR para evitar
# apagar itens por engano. Remove somente entidades de item na area atual.
command /rpgitenslimpar [<text>]:
    permission: rpg.admin
    permission message: {@prefix}&cVocê não tem permissão para isso.
    trigger:
        set {_found} to false
        loop {rpg::territories::*}:
            set {_territory} to loop-value
            if {rpg::territory::%{_territory}%::world} is "%world of player%":
                set {_dx} to (floor(x-coordinate of player)) - {rpg::territory::%{_territory}%::x}
                set {_dz} to (floor(z-coordinate of player)) - {rpg::territory::%{_territory}%::z}
                if abs({_dx}) <= {@territory-radius} and abs({_dz}) <= {@territory-radius}:
                    set {_found} to true
                    stop loop
        if {_found} is false:
            send "{@prefix}&cVocê precisa estar dentro de um território reivindicado." to player
            stop
        if arg-1 is not "CONFIRMAR":
            send "{@prefix}&eAtenção: isso removerá os itens dropados existentes neste território, inclusive itens legítimos." to player
            send "{@prefix}&ePara executar, use &c/rpgitenslimpar CONFIRMAR&e." to player
            stop
        set {_removed} to 0
        loop all dropped items in player's world:
            set {_itemLocation} to location of loop-entity
            set {_ix} to (x-coordinate of {_itemLocation}) - {rpg::territory::%{_territory}%::x}
            set {_iz} to (z-coordinate of {_itemLocation}) - {rpg::territory::%{_territory}%::z}
            if abs({_ix}) <= {@territory-radius} and abs({_iz}) <= {@territory-radius}:
                delete loop-entity
                add 1 to {_removed}
        set {_timestamp} to "%now%"
        set {_actor} to "%player%"
        set {_actorUUID} to "%uuid of player%"
        set {_worldName} to "%world of player%"
        set {_posX} to floor(x-coordinate of player)
        set {_posY} to floor(y-coordinate of player)
        set {_posZ} to floor(z-coordinate of player)
        add "%{_timestamp}% | %{_actor}% | %{_actorUUID}% | mundo=%{_worldName}% | território=%{_territory}% | posição=%{_posX}%,%{_posY}%,%{_posZ}% | removidos=%{_removed}%" to {rpg::territory-cleanup-log::*}
        send "{@prefix}&aLimpeza concluída: &e%{_removed}%&a entidades de itens removidas." to player
        send "{@prefix}&7Ação registrada no histórico administrativo." to player

# Histórico persistente das limpezas administrativas de territórios.
command /rpgitenslog:
    permission: rpg.admin
    permission message: {@prefix}&cVocê não tem permissão para isso.
    trigger:
        if size of {rpg::territory-cleanup-log::*} is 0:
            send "{@prefix}&7Ainda não há limpezas registradas." to player
            stop
        send "&6&lHISTÓRICO DE LIMPEZA DE ITENS" to player
        loop {rpg::territory-cleanup-log::*}:
            send "&7%loop-value%" to player
