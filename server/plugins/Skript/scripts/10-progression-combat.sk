options:
    prefix: &8[&6RPG Revolution&8] &r

on death of living entity:
    attacker is a player
    victim is not a player
    set {_id} to "%uuid of attacker%"
    if {rpg::%{_id}%::created} is true:
        rpg_add_xp(attacker, 10)
        add 5 to {rpg::%{_id}%::coins}
        send "{@prefix}&a+10 XP &8| &6+5 moedas &7por derrotar uma criatura." to attacker

on damage of living entity:
    attacker is a player
    victim is not a player
    set {_id} to "%uuid of attacker%"
    if {rpg::%{_id}%::created} is true:
        set {_strength} to {rpg::%{_id}%::strength}
        if {_strength} > 1:
            set {_bonus} to ({_strength} - 1) * 0.5
            increase damage by {_bonus}
